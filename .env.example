# ==============================================
# GLOBAL STARKNET CONFIGURATION
# ==============================================

# Network Configuration
STARKNET_NETWORK=mainnet
STARKNET_RPC="https://api.cartridge.gg/x/starknet/mainnet/rpc/v0_8"

# Account Configuration
# Path to the account.json file generated from starkli
STARKNET_ACCOUNT=./account_path.json
STARKNET_PK=xxx

# Deployment Type
# Set to "true" to deploy to Slot (local development)
# Set to "false" to deploy to a real network
DEPLOY_TO_SLOT=false

# ==============================================
# SURVIVOR GOVERNANCE CONFIGURATION
# ==============================================

# Survivor Token Configuration
TOKEN_NAME="Test Token"
TOKEN_SYMBOL="TEST"
INITIAL_SUPPLY=10000000000000000000000000  # 10,000,000 tokens with 18 decimals
TOKEN_RECIPIENT=xxx

# Survivor Governor Controller Configuration
MIN_DELAY=3600  # 1 hour in seconds
ADMIN=""  # Leave empty to use deployer account